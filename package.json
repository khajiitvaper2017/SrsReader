{
  "name": "srs-reader",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:store": "wxt zip --config wxt.store.config.ts --mode store",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm build && playwright test",
    "test:browser": "node e2e/browser.ts",
    "phone:update": "node e2e/phone.ts",
    "benchmark": "node e2e/actions.bench.ts",
    "check:unused": "knip",
    "fix:unused": "knip --fix --fix-type exports,types --format",
    "fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@pointnet/cldr-spellout": "48.2.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@zip.js/zip.js": "^2.24.0",
    "bzip2": "^0.1.1",
    "dexie": "^4.4.7",
    "dexie-export-import": "^4.4.2",
    "fzstd": "^0.1.1",
    "i18next": "^26.7.1",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-markdown": "10.1.0",
    "ts-fsrs": "6.0.0",
    "xz-decompress": "^0.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "10.14.0",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1",
    "wxt": "^0.21.5"
  }
}
